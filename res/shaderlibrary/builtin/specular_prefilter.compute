// GGX specular prefilter (split-sum IBL, Phase 3).
// Importance sampling matches liangairan/pbr/prefilterSpecularMap.
// Each dispatch writes one roughness mip of the destination cubemap.
#include "frame.hlsl"
#include "descriptor_bindings.hlsl"

#define PI 3.14159265359

[[vk::binding(0, MATERIAL_SET)]] cbuffer prefilter_ubo : register(b0)
{
    float roughness;
    float envResolution;
    float2 prefilterPad;
};

[[vk::binding(1, MATERIAL_SET)]] TextureCube envMap : register(t0);
[[vk::binding(2, MATERIAL_SET)]] SamplerState sampler_envMap : register(s0);

[[vk::binding(3, MATERIAL_SET)]]
[[vk::image_format("rgba8")]]
RWTexture2DArray<unorm float4> prefilteredMap : register(u0);

float DistributionGGX(float3 N, float3 H, float a_roughness)
{
    float a = a_roughness * a_roughness;
    float a2 = a * a;
    float NdotH = max(dot(N, H), 0.0);
    float NdotH2 = NdotH * NdotH;

    float nom = a2;
    float denom = (NdotH2 * (a2 - 1.0) + 1.0);
    denom = PI * denom * denom;
    return nom / max(denom, 1e-6);
}

float RadicalInverse_VdC(uint bits)
{
    bits = (bits << 16u) | (bits >> 16u);
    bits = ((bits & 0x55555555u) << 1u) | ((bits & 0xAAAAAAAAu) >> 1u);
    bits = ((bits & 0x33333333u) << 2u) | ((bits & 0xCCCCCCCCu) >> 2u);
    bits = ((bits & 0x0F0F0F0Fu) << 4u) | ((bits & 0xF0F0F0F0u) >> 4u);
    bits = ((bits & 0x00FF00FFu) << 8u) | ((bits & 0xFF00FF00u) >> 8u);
    return float(bits) * 2.3283064365386963e-10;
}

float2 Hammersley(uint i, uint N)
{
    return float2(float(i) / float(N), RadicalInverse_VdC(i));
}

float3 ImportanceSampleGGX(float2 Xi, float3 N, float a_roughness)
{
    float a = a_roughness * a_roughness;

    float phi = 2.0 * PI * Xi.x;
    float cosTheta = sqrt((1.0 - Xi.y) / (1.0 + (a * a - 1.0) * Xi.y));
    float sinTheta = sqrt(max(1.0 - cosTheta * cosTheta, 0.0));

    float3 H;
    H.x = cos(phi) * sinTheta;
    H.y = sin(phi) * sinTheta;
    H.z = cosTheta;

    // Stable tangent frame (cube +Y/-Y faces have N parallel to (0,1,0)).
    float3 up = abs(N.z) < 0.999 ? float3(0.0, 0.0, 1.0) : float3(1.0, 0.0, 0.0);
    float3 tangent = normalize(cross(up, N));
    float3 bitangent = cross(N, tangent);
    return normalize(tangent * H.x + bitangent * H.y + N * H.z);
}

float3 CubemapDirection(uint faceIndex, float2 uv)
{
    float2 st = uv * 2.0 - 1.0;
    if (faceIndex == 0) {
        return float3(1.0, -st.y, -st.x);
    }
    if (faceIndex == 1) {
        return float3(-1.0, -st.y, st.x);
    }
    if (faceIndex == 2) {
        return float3(st.x, 1.0, st.y);
    }
    if (faceIndex == 3) {
        return float3(st.x, -1.0, -st.y);
    }
    if (faceIndex == 4) {
        return float3(st.x, -st.y, 1.0);
    }
    return float3(-st.x, -st.y, -1.0);
}

[numthreads(8, 8, 1)]
void main(uint3 DTid : SV_DispatchThreadID)
{
    uint width = 0;
    uint height = 0;
    uint layers = 0;
    prefilteredMap.GetDimensions(width, height, layers);
    if (DTid.x >= width || DTid.y >= height || DTid.z >= 6) {
        return;
    }

    float2 uv = (float2(DTid.xy) + 0.5) / float2(width, height);
    float3 N = normalize(CubemapDirection(DTid.z, uv));
    float3 R = N;
    float3 V = R;

    const uint SAMPLE_COUNT = 1024u;
    float3 prefilteredColor = float3(0.0, 0.0, 0.0);
    float totalWeight = 0.0;
    const float resolution = max(envResolution, 1.0);

    for (uint i = 0u; i < SAMPLE_COUNT; ++i)
    {
        float2 Xi = Hammersley(i, SAMPLE_COUNT);
        float3 H = ImportanceSampleGGX(Xi, N, roughness);
        float3 L = normalize(2.0 * dot(V, H) * H - V);

        float NdotL = max(dot(N, L), 0.0);
        if (NdotL > 0.0)
        {
            float D = DistributionGGX(N, H, roughness);
            float NdotH = max(dot(N, H), 0.0);
            float HdotV = max(dot(H, V), 0.0);
            float pdf = D * NdotH / (4.0 * HdotV) + 0.0001;

            float saTexel = 4.0 * PI / (6.0 * resolution * resolution);
            float saSample = 1.0 / (float(SAMPLE_COUNT) * pdf + 0.0001);
            float mipLevel = roughness == 0.0 ? 0.0 : 0.5 * log2(saSample / saTexel);

            prefilteredColor += envMap.SampleLevel(sampler_envMap, L, mipLevel).rgb * NdotL;
            totalWeight += NdotL;
        }
    }

    prefilteredColor = prefilteredColor / max(totalWeight, 1e-4);
    prefilteredMap[DTid] = float4(prefilteredColor, 1.0);
}
